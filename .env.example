# ==========================================
# Google Cloud Platform Configuration
# ==========================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-flash-001

# Optional: Direct Gemini API key (if testing outside GCP Vertex AI IAM)
# GEMINI_API_KEY=AIzaSy...

# Cloud Firestore & Cloud Storage
FIRESTORE_DATABASE=(default)
GCS_BUCKET_NAME=podlens-media-staging

# Set DEMO_MODE to true to enable pre-grounded fallback cards if GCP quota/network is limited
DEMO_MODE=true

# Server Port
PORT=8000
